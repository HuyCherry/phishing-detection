{
  "manifest_version": 3,
  "name": "PhishGuardAI",
  "version": "1.0",
  "description": "Bảo vệ bạn khỏi các trang web lừa đảo (phishing) bằng AI và Threat Intel.",
  "permissions": [
    "webNavigation",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "css": ["content/content_style.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuardAI"
  }
}
