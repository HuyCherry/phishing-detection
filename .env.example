# ─── API Keys ───────────────────────────────────────────────────────────
# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Get from: https://console.developers.google.com/
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here

# Optional: URLhaus (no API key needed, but can set for priority)
URLHAUS_API_KEY=optional

# Optional: PhishTank (requires registration)
PHISHTANK_API_KEY=optional

# Optional: OpenPhish (no key needed)
OPENPHISH_API_KEY=optional

# ─── Screenshot Analysis (Optional) ──────────────────────────────────────
# For screenshot-based analysis feature
SCREENSHOT_SERVICE_URL=https://api.example.com/screenshot
SCREENSHOT_API_KEY=optional

# ─── Database Settings ──────────────────────────────────────────────────
DATABASE_PATH=./data/history.db
REPORTS_DATABASE_PATH=./data/reports.db

# ─── Model Settings ────────────────────────────────────────────────────
MODEL_PATH=./model/phishing_model.pkl
MODEL_ENSEMBLE_TYPE=random_forest_xgboost_lightgbm

# ─── Whitelisting (Official Domains) ────────────────────────────────────
# Comma-separated list of official trusted domains
OFFICIAL_FACEBOOK_DOMAINS=facebook.com,fb.com,fb.me
OFFICIAL_YOUTUBE_DOMAINS=youtube.com,youtu.be
OFFICIAL_INSTAGRAM_DOMAINS=instagram.com
OFFICIAL_TIKTOK_DOMAINS=tiktok.com,tiktok.tv
OFFICIAL_GOOGLE_DOMAINS=google.com,google.vn
OFFICIAL_PAYPAL_DOMAINS=paypal.com
OFFICIAL_AMAZON_DOMAINS=amazon.com
OFFICIAL_TWITTER_DOMAINS=twitter.com,x.com
OFFICIAL_MICROSOFT_DOMAINS=microsoft.com,outlook.com,hotmail.com

# ─── Logging & Monitoring ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/phishing_detector.log
ENABLE_ANALYTICS=true

# ─── Community Features ────────────────────────────────────────────────
ENABLE_COMMUNITY_REPORTS=true
COMMUNITY_REPORT_THRESHOLD=3  # Number of reports to mark as suspicious
ENABLE_USER_FEEDBACK=true

# ─── Timeout & Performance ─────────────────────────────────────────────
SOCKET_TIMEOUT=10
API_CALL_TIMEOUT=15
SSL_CHECK_TIMEOUT=5
WHOIS_TIMEOUT=10
SCREENSHOT_TIMEOUT=30

# ─── Content Analysis ───────────────────────────────────────��──────────
ENABLE_SCREENSHOT_ANALYSIS=false  # Requires Selenium/Playwright
ENABLE_CONTENT_SIMILARITY=false   # Requires additional setup
CONTENT_SIMILARITY_THRESHOLD=0.85

# ─── Email Features (Future - ThePhish Integration) ─────────────────────
# ENABLE_EMAIL_ANALYSIS=false
# IMAP_SERVER=smtp.gmail.com
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
